# Database - local MongoDB (development)
MONGODB_URI="mongodb://127.0.0.1:27017/kpesh"

# For Netlify production, use MongoDB Atlas instead:
# MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/kpesh?retryWrites=true&w=majority"

# Admin session signing secret (minimum 32 characters)
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# ImageKit media hosting
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=""

# Resend (optional email notifications)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
INQUIRY_NOTIFICATION_EMAIL=""

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First-run admin seed (used only by the seed script)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
